        <Param val="if (corans) {&amp;#10;    score += 1;&amp;#10;    text_feedback = `Correto!&amp;#10;+1 point&amp;#10;Total: ${score}`&amp;#10;;&amp;#10;    psychoJS.window.color = &quot;green&quot;;&amp;#10;    sound_feedback = 4000;&amp;#10;    durationtext = 0.5;&amp;#10;    volume = 1;&amp;#10;    duration = 0.25;&amp;#10;} else {&amp;#10;    score += 0;&amp;#10;    text_feedback = `Errado!&amp;#10;+0 points&amp;#10;Total: ${score}`&amp;#10;;&amp;#10;    psychoJS.window.color = &quot;red&quot;;&amp;#10;    sound_feedback = &quot;sound_files/ibl_noise_burst.wav&quot;;&amp;#10;    durationtext = 1.5;&amp;#10;    volume = 1;&amp;#10;    duration = 0.5;&amp;#10;}&amp;#10;psychoJS.window.flip();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if corans:&amp;#10;    score += 1&amp;#10;    text_feedback = f&quot;Correto!\n+1 point\nTotal: {score}&quot;&amp;#10;    win.color = &quot;green&quot;&amp;#10;    sound_feedback = 4000&amp;#10;    durationtext = 0.5&amp;#10;    volume = 1&amp;#10;    duration = 0.25&amp;#10;else:&amp;#10;    score += 0&amp;#10;    text_feedback = f&quot;Errado!\n+0 points\nTotal: {score}&quot;&amp;#10;    win.color = &quot;red&quot;&amp;#10;    sound_feedback = &quot;sound_files/ibl_noise_burst.wav&quot;&amp;#10;    durationtext = 1.5&amp;#10;    volume = 1&amp;#10;    duration = 0.5&amp;#10;&amp;#10;    &amp;#10;win.flip()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
