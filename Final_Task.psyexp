        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Irá iniciar a tarefa. A mesma consiste na apresentação de um contraste à direita/esquerda. Indique em cada trial o lado do estímulo utilizando a tecla -S- para o lado esquerdo e  -L- para o lado direito. &amp;#10;&amp;#10;Pedimos que mantenha o olhar no centro do ecrã durante a experiência&amp;#10;&amp;#10;Pressione a SPACEBAR para começar" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
