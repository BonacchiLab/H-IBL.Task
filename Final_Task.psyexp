        <Param val="corans = false;&amp;#10;if (((position[0] &gt; 0) &amp;&amp; (gabor.pos[0] === 0.0))) {&amp;#10;    corans = true;&amp;#10;} else {&amp;#10;    if (((position[0] &lt; 0) &amp;&amp; (gabor.pos[0] === 0.0))) {&amp;#10;        corans = true;&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;Correct answer&quot;, corans);&amp;#10;total_task_time = total_task_timer.getTime();&amp;#10;console.log(`TOTAL TASK TIME: ${util.pad(Number.parseFloat(total_task_time).toFixed(2), 1)} SECONDS&amp;#10;`);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="corans = False&amp;#10;&amp;#10;if position[0] &gt; 0 and gabor.pos[0] == 0.0:&amp;#10;    corans = True&amp;#10;&amp;#10;&amp;#10;elif position[0] &lt; 0 and gabor.pos[0] == 0.0:&amp;#10;    corans = True&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;thisExp.addData('Correct answer', corans)&amp;#10;&amp;#10;total_task_time = total_task_timer.getTime()&amp;#10;print(f&quot;TOTAL TASK TIME: {total_task_time:.2f} SECONDS\n&quot;)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
