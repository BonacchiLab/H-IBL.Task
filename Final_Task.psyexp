        <Param val="current_phaseT = np.random.uniform(0, (2 * np.pi));&amp;#10;gaborTut.phase = current_phaseT;&amp;#10;psychoJS.experiment.addData(&quot;gabor_phaseT&quot;, current_phaseT);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
